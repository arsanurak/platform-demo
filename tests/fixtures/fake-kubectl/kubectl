#!/usr/bin/env python3
"""A fake kubectl for tests: serves objects from a JSON file and records every call.

FAKE_KUBE_STATE: JSON file {"<context>/<kind>/<namespace>/<name>": object}, read and rewritten.
FAKE_KUBE_LOG: every call is appended as one JSON array of its arguments.
Understands only what the repo's scripts use: get -o json, scale, patch --type=json,
apply -f - (a JSON List on stdin) and rollout status.
"""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_KUBE_LOG"], "a") as log:
    log.write(json.dumps(args) + "\n")

flags, words = {}, []
i = 0
while i < len(args):
    arg = args[i]
    if arg.startswith("-"):
        name, _, value = arg.partition("=")
        if not value and name in {"--kubeconfig", "--context", "-n", "-o", "-f", "-p", "--type", "--timeout"}:
            i += 1
            value = args[i]
        flags[name] = value
    else:
        words.append(arg)
    i += 1

state_file = os.environ["FAKE_KUBE_STATE"]
with open(state_file) as f:
    state = json.load(f)
context = flags.get("--context", "")
namespace = flags.get("-n", "default")
KINDS = {"deployment": "Deployment", "httproute": "HTTPRoute", "application": "Application", "gateway": "Gateway"}


def key(kind, name, ns=namespace):
    return f"{context}/{KINDS.get(kind, kind)}/{ns}/{name}"


def save():
    with open(state_file, "w") as f:
        json.dump(state, f, indent=2)


verb = words[0]
if verb == "get":
    obj = state.get(key(words[1], words[2]))
    if obj is None:
        sys.exit(f'Error from server (NotFound): {words[1]} "{words[2]}" not found')
    print(json.dumps(obj))
elif verb == "scale":
    kind, name = words[1].split("/") if "/" in words[1] else (words[1], words[2])
    state[key(kind, name)]["spec"]["replicas"] = int(flags["--replicas"])
    save()
elif verb == "patch":
    obj = state[key(words[1], words[2])]
    for op in json.loads(flags["-p"]):
        assert op["op"] == "replace", op
        *parents, last = [int(p) if p.isdigit() else p for p in op["path"].strip("/").split("/")]
        target = obj
        for part in parents:
            target = target[part]
        target[last] = op["value"]
    save()
elif verb == "apply":
    for obj in json.load(sys.stdin)["items"]:
        state[key(obj["kind"], obj["metadata"]["name"], obj["metadata"]["namespace"])] = obj
    save()
elif verb == "rollout" and words[1] == "status":
    pass
else:
    sys.exit(f"fake kubectl: unsupported call {args}")
